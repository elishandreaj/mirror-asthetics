# ─────────────────────────────────────────────────────────────
#  Mirror Aesthetics – environment settings
#  Copy this file to ".env" for local use. Neon CLI writes credentials to
#  ".env.local", which the app loads before ".env". On Render/VPS, set
#  these as environment variables. NEVER commit real environment files.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# Your live website address (used in emails and links). No trailing slash.
PUBLIC_URL=https://www.mirroraesthetics.ph

# PostgreSQL connection string (Neon, Render, Supabase or your own server)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# "true" for hosted databases (Neon/Render/Supabase). "false" for the docker-compose database.
DATABASE_SSL=true

# VPS / docker-compose only: password for the bundled database (DATABASE_URL is then set automatically)
POSTGRES_PASSWORD=

# Long random secret for staff login sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a staff login lasts (hours)
SESSION_HOURS=12

# First admin account – created automatically on first start if no users exist.
# Change the password after your first login (Dashboard → My password).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe2026!
# Optional: private staff dashboard path (e.g. mirror-staff-7Q2)
ADMIN_PATH=admin
ADMIN_NAME=Clinic Owner

# ── Email (optional but recommended) ──────────────────────────
# Brevo API works on Render Free (which blocks SMTP ports). Verify your sender in Brevo.
BREVO_API_KEY=
# SMTP (Gmail etc.) works on paid Render / VPS.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=your@gmail.com,
#        SMTP_PASS=<16-letter App Password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mirror Aesthetics <mgr.mirror@gmail.com>"
# Inbox that receives "new booking" alerts (defaults to the clinic email in Settings)
NOTIFY_EMAIL=

# Max upload size for photos (MB)
MAX_UPLOAD_MB=8

# Number of proxies in front of the app (Render/Caddy = 1)
TRUST_PROXY=1
TZ=Asia/Manila
